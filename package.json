{
  "name": "portfolio-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Security-first backend foundation for a personal portfolio.",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "NODE_ENV=development node --env-file=.env --watch src/server.mjs",
    "start": "NODE_ENV=production node src/server.mjs",
    "test": "node --test",
    "check": "node --check src/server.mjs && node --check public/loader.js && node --test"
  }
}
