# Public URL used to validate browser requests. Do not include a trailing slash.
SITE_ORIGIN=http://localhost:3000
PORT=3000
NODE_ENV=development

# Leave false unless the app is behind a trusted reverse proxy that replaces
# (rather than appends untrusted values to) X-Forwarded-For.
TRUST_PROXY=false

# Contact delivery is disabled unless all four values below are set.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
CONTACT_REPLY_TO=true

# Random secret used only to hash rate-limit identifiers. Use 32+ random bytes.
RATE_LIMIT_SECRET=replace-with-a-long-random-value

